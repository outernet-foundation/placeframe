// Box-side Alloy: scrapes every container in the placeframe compose project
// over docker.sock and writes to the local box-Loki on 127.0.0.1:3100. Mirrors
// the main-compose docker/alloy/config.alloy but adds `box_id` as an external
// label so each entry carries the box's hardware identity once at write time,
// not per-line in the producer's logging config.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
    // Push every 100ms instead of the default 1s so live debugging during a
    // box-side failure cascade loses at most ~100ms of in-flight log lines
    // before the alloy in-memory buffer is dropped. The durable per-service
    // file logs on the zed-logs volume are the post-recovery source of
    // truth; this just narrows the live-relay gap.
    batch_wait = "100ms"
  }
  external_labels = {
    box_id = sys.env("ZED_BOX_ID"),
  }
}
