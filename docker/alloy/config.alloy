// OTLP/gRPC receiver → OTLP/HTTP exporter into Loki's native OTLP ingestion
// endpoint (/otlp/v1/logs). Producers ship OTel log records with full SemConv
// resource attributes (service.name, service.namespace, service.instance.id,
// service.version, deployment.environment.name, container.name). Loki itself
// decides the label/metadata split (see limits_config.otlp_config): the body
// becomes the log line, the indexed resource subset becomes labels, and
// everything else becomes structured metadata. Endpoint is env-driven so this
// single config serves both the main backend stack (writes to loki:3100) and
// the ZED box stack (writes to 127.0.0.1:3100); the otlphttp exporter appends
// /v1/logs to it.

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  output {
    logs = [otelcol.exporter.otlphttp.default.input]
  }
}

otelcol.exporter.otlphttp "default" {
  client {
    endpoint = sys.env("LOKI_OTLP_ENDPOINT")
  }
}
