  "components": {
    "schemas": {
      "StartCaptureRequest": {
        "properties": {
          "started_at": {
            "type": "string",
            "format": "date-time",
            "description": "datetime with the constraint that the value must have timezone info"
          },
          "capture_interval": {
            "nullable": true,
            "type": "number",
            "format": "double"
          }
        },
        "type": "object",
        "required": [
          "started_at"
        ],
        "title": "StartCaptureRequest"
      },
      "StopCaptureRequest": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "StopCaptureRequest"
      },
      "UpdateCaptureSessionRequest": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "UpdateCaptureSessionRequest"
      },
      "ZedCapture": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time",
            "description": "datetime with the constraint that the value must have timezone info"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "recorded_at",
          "size_bytes"
        ],
        "title": "ZedCapture"
      },
      "ZedStatus": {
        "properties": {
          "current_capture_id": {
            "nullable": true,
            "type": "string",
            "format": "uuid"
          },
          "tracking_state": {
            "type": "string"
          },
          "stabilizing": {
            "type": "boolean"
          },
          "last_exception": {
            "nullable": true,
            "type": "string"
          },
          "disk_free_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "uptime_s": {
            "type": "number",
            "format": "double"
          },
          "version": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "disk_free_bytes",
          "stabilizing",
          "tracking_state",
          "uptime_s",
