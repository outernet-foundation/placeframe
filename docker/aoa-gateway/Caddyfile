{
	auto_https off
	log default {
		level DEBUG
		output stdout
		format json
	}
	servers :9000 {
		protocols h1 h2c
	}
}

http://:9000 {
	# Loopback-only bind so the box's wired ethernet doesn't expose this
	# listener. aoa-bridge forwards AOA bulk endpoints to 127.0.0.1:9000 in
	# the host network namespace, so loopback is the only route the phone
	# reaches us through.
	bind 127.0.0.1

	# Dual-output access log. stdout feeds the alloy → aoa-loki pipeline for
	# the phone-side log relay. The file on /var/log/zed-capture (shared
	# zed-logs volume with zed-capture and aoa-bridge) is the durable copy
	# that survives an AOA-wedge-induced power-cycle, since the alloy
	# in-memory buffer is lost when the failure cascade drops the pipeline.
	log {
		output stdout
		format json
	}
	log {
		output file /var/log/zed-capture/aoa-gateway.jsonl {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}

	# Phone-side log relay: query box-Loki over the AOA pipe. Box-Loki binds
	# 127.0.0.1:3100 only; this handle is the sole route the phone can reach.
	handle /loki/* {
		reverse_proxy http://127.0.0.1:3100
	}

	handle {
		reverse_proxy http://127.0.0.1:9001
	}
}
