{
  "info": {
    "title": "Localizer",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "paths": {
    "/localization": {
      "post": {
        "summary": "LocalizeImage",
        "operationId": "localize_image",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/LocalizationRequest"
              },
              "encoding": {
                "camera_config": {
                  "contentType": "application/json",
                  "explode": false,
                  "allowReserved": false
                },
                "metrics": {
                  "contentType": "application/json",
                  "explode": false,
                  "allowReserved": false
                },
                "reconstruction_ids": {
                  "contentType": "application/json",
                  "explode": false,
                  "allowReserved": false
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Document created, URL follows",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Localization"
                  },
                  "type": "array"
                }
              }
            }
          },
          "400": {
            "description": "Bad request syntax or unsupported method",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status_code": {
                      "type": "integer"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "extra": {
                      "additionalProperties": {},
                      "anyOf": [
                        {
                          "type": "object"
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ],
                      "nullable": true
                    }
                  },
                  "type": "object",
                  "required": [
                    "detail",
                    "status_code"
                  ],
                  "description": "Validation Exception",
                  "example": {
                    "status_code": 400,
                    "detail": "Bad Request",
                    "extra": {}
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    },
    "/version": {
      "get": {
        "summary": "GetLocalizerVersion",
        "operationId": "get_localizer_version",
        "responses": {
          "200": {
            "description": "Request fulfilled, document follows",
            "headers": {},
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "components": {
    "schemas": {
      "AxisConvention": {
        "type": "string",
        "enum": [
          "OPENCV",
          "UNITY"
        ],
        "title": "AxisConvention"
      },
      "Float3": {
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "z": {
            "type": "number"
          }
        },
        "type": "object",
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "Float3"
      },
      "Float4": {
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "w": {
            "type": "number"
          }
        },
        "type": "object",
        "required": [
          "w",
          "x",
          "y",
          "z"
        ],
        "title": "Float4"
      },
      "Localization": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "transform": {
            "$ref": "#/components/schemas/Transform"
          },
          "metrics": {
            "$ref": "#/components/schemas/LocalizationMetrics"
          }
        },
        "type": "object",
        "required": [
          "id",
          "metrics",
          "transform"
        ],
        "title": "Localization"
      },
      "LocalizationMetrics": {
        "properties": {
          "inlier_ratio": {
            "type": "number"
          },
          "reprojection_error_median": {
            "type": "number"
          },
          "num_inliers": {
            "type": "integer"
          },
          "num_correspondences": {
            "type": "integer"
          },
          "num_matches": {
            "type": "integer"
          },
          "inlier_coverage": {
            "type": "number"
          },
          "confidence_tight": {
            "type": "number"
          },
          "confidence_loose": {
            "type": "number"
          },
          "confidence_is_calibrated": {
            "type": "boolean"
          },
          "measurement_covariance": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array"
          },
          "pnp_covariance": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array"
          },
          "pipeline_version": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "confidence_is_calibrated",
          "confidence_loose",
          "confidence_tight",
          "inlier_coverage",
          "inlier_ratio",
          "measurement_covariance",
          "num_correspondences",
          "num_inliers",
          "num_matches",
          "pipeline_version",
          "pnp_covariance",
          "reprojection_error_median"
        ],
        "title": "LocalizationMetrics"
      },
      "LocalizationRequest": {
        "properties": {
          "reconstruction_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array"
          },
          "metrics": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ReconstructionMetrics"
            },
            "type": "object"
          },
          "camera_config": {
            "$ref": "#/components/schemas/PinholeCameraConfig"
          },
          "axis_convention": {
            "$ref": "#/components/schemas/AxisConvention"
          },
          "retrieval_top_k": {
            "nullable": true,
            "type": "integer"
          },
          "ransac_threshold": {
            "nullable": true,
            "type": "number"
          },
          "image": {
            "type": "string",
            "format": "binary"
          }
        },
        "type": "object",
        "required": [
          "axis_convention",
          "camera_config",
          "image",
          "metrics",
          "reconstruction_ids"
        ],
        "title": "LocalizationRequest"
      },
      "PinholeCameraConfig": {
        "properties": {
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "orientation": {
            "type": "string",
            "enum": [
              "TOP_LEFT",
              "TOP_RIGHT",
              "BOTTOM_RIGHT",
              "BOTTOM_LEFT",
              "LEFT_TOP",
              "RIGHT_TOP",
              "RIGHT_BOTTOM",
              "LEFT_BOTTOM"
            ]
          },
          "fx": {
            "type": "number"
          },
          "fy": {
            "type": "number"
          },
          "cx": {
            "type": "number"
          },
          "cy": {
            "type": "number"
          }
        },
        "type": "object",
        "required": [
          "cx",
          "cy",
          "fx",
          "fy",
          "height",
          "orientation",
          "width"
        ],
        "title": "PinholeCameraConfig"
      },
      "ReconstructionMetrics": {
        "properties": {
          "total_images": {
            "description": "Total number of input images considered for this reconstruction run.",
            "nullable": true,
            "type": "integer"
          },
          "registered_images": {
            "description": "Number of images successfully registered into the final model.",
            "nullable": true,
            "type": "integer"
          },
          "registration_rate": {
            "description": "Registration rate in percent: 100 \u00d7 (registered_images / total_images). Computed after selecting the best reconstruction (max registered images).",
            "nullable": true,
            "type": "number"
          },
          "num_3d_points": {
            "description": "Count of 3D points in the selected 'best' reconstruction.",
            "nullable": true,
            "type": "integer"
          },
          "average_keypoints_per_image": {
            "description": "Average number of detected keypoints per image (after ALIKED extraction), computed across all images.",
            "nullable": true,
            "type": "number"
          },
          "reprojection_pixel_error_50th_percentile": {
            "description": "Median (50th percentile) reprojection error in pixels across all valid 2D observations in registered images, measured using image.project_point(point3D.xyz) vs. observed 2D keypoint.",
            "nullable": true,
            "type": "number"
          },
          "reprojection_pixel_error_90th_percentile": {
            "description": "90th percentile reprojection error in pixels across all valid 2D observations, computed the same way as the median.",
            "nullable": true,
            "type": "number"
          },
          "track_length_50th_percentile": {
            "description": "Median (50th percentile) track length across 3D points in the selected model. Track length = number of distinct images observing the point.",
            "nullable": true,
            "type": "number"
          },
          "percent_tracks_with_length_greater_than_or_equal_to_3": {
            "description": "Percentage of 3D points whose track length is \u2265 3 (a common robustness threshold). Computed as 100 \u00d7 (#points with length\u22653 / #points).",
            "nullable": true,
            "type": "number"
          },
          "all_verified_matches": {
            "description": "Total number of verified matches across all image pairs.",
            "nullable": true,
            "type": "integer"
          },
          "all_verified_match_rate": {
            "description": "Percentage of verified matches across all image pairs.",
            "nullable": true,
            "type": "number"
          },
          "all_verified_match_inliers_mean": {
            "description": "Mean number of inliers for all verified matches.",
            "nullable": true,
            "type": "number"
          },
          "all_verified_match_inliers_median": {
            "description": "Median number of inliers for all verified matches.",
            "nullable": true,
            "type": "number"
          },
          "stereo_verified_matches": {
            "description": "Number of verified matches for stereo pairs (same frame, different sensors).",
            "nullable": true,
            "type": "integer"
          },
          "stereo_verified_match_rate": {
            "description": "Percentage of verified matches for stereo pairs.",
            "nullable": true,
            "type": "number"
          },
          "stereo_verified_match_inliers_mean": {
            "description": "Mean number of inliers for verified matches for stereo pairs.",
            "nullable": true,
            "type": "number"
          },
          "stereo_verified_match_inliers_median": {
            "description": "Median number of inliers for verified matches for stereo pairs.",
            "nullable": true,
            "type": "number"
          },
          "same_sensor_verified_matches": {
            "description": "Number of verified matches for same-sensor pairs (across frames).",
            "nullable": true,
            "type": "integer"
          },
          "same_sensor_verified_match_rate": {
            "description": "Percentage of verified matches for same-sensor pairs.",
            "nullable": true,
            "type": "number"
          },
          "same_sensor_verified_match_inliers_mean": {
            "description": "Mean number of inliers for verified matches for same-sensor pairs.",
            "nullable": true,
            "type": "number"
          },
          "same_sensor_verified_match_inliers_median": {
            "description": "Median number of inliers for verified matches for same-sensor pairs.",
            "nullable": true,
            "type": "number"
          },
          "cross_sensor_verified_matches": {
            "description": "Number of verified matches for cross-sensor pairs (across frames).",
            "nullable": true,
            "type": "integer"
          },
          "cross_sensor_verified_match_rate": {
            "description": "Percentage of verified matches for cross-sensor pairs.",
            "nullable": true,
            "type": "number"
          },
          "cross_sensor_verified_match_inliers_mean": {
            "description": "Mean number of inliers for verified matches for cross-sensor pairs.",
            "nullable": true,
            "type": "number"
          },
          "cross_sensor_verified_match_inliers_median": {
            "description": "Median number of inliers for verified matches for cross-sensor pairs.",
            "nullable": true,
            "type": "number"
          },
          "map_image_count": {
            "description": "Number of registered images in the reconstruction.",
            "nullable": true,
            "type": "integer"
          },
          "map_point_count": {
            "description": "Number of triangulated 3D points in the reconstruction.",
            "nullable": true,
            "type": "integer"
          },
          "map_avg_track_length": {
            "description": "Mean number of image observations per 3D point. Coarse density-of-evidence proxy.",
            "nullable": true,
            "type": "number"
          },
          "map_bounding_volume_m3": {
            "description": "Convex-hull volume of registered camera centers, in cubic meters. Captures spatial extent; complements image_count which only captures coverage density.",
            "nullable": true,
            "type": "number"
          },
          "map_viewpoint_diversity": {
            "description": "1 - |mean(unit viewing direction)| across registered cameras. Zero when all cameras face the same way; approaches one as viewing directions spread uniformly. Discriminates panoramic sweeps from single-viewpoint maps even when the rest of the metrics agree.",
            "nullable": true,
            "type": "number"
          },
          "truth_alignment_rms_residual_m": {
            "description": "RMS over registered cameras of ||T\u00b7c_map - c_truth|| in meters, where T is the rigid Umeyama alignment from map to truth applied during reconstruction. Diagnostic for VIO-truth quality: small (~cm) means the truth poses are internally consistent with the COLMAP geometry; large values indicate VIO drift, scale errors, or other capture-time pose noise that disqualifies the capture from calibration.",
            "nullable": true,
            "type": "number"
          },
          "truth_alignment_max_residual_m": {
            "description": "Maximum over registered cameras of ||T\u00b7c_map - c_truth|| in meters. Companion to the RMS field; surfaces single-frame outliers that the RMS would smooth over.",
            "nullable": true,
            "type": "number"
          }
        },
        "type": "object",
        "required": [],
        "title": "ReconstructionMetrics"
      },
      "Transform": {
        "properties": {
          "translation": {
            "$ref": "#/components/schemas/Float3"
          },
          "rotation": {
            "$ref": "#/components/schemas/Float4"
          }
        },
        "type": "object",
        "required": [
          "rotation",
          "translation"
        ],
        "title": "Transform"
      }
    }
  }
}