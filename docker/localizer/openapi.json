{
  "info": {
    "title": "Localizer",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "paths": {
    "/localization": {
      "post": {
        "summary": "LocalizeImage",
        "operationId": "localize_image",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/LocalizationRequest"
              },
              "encoding": {
                "camera_config": {
                  "contentType": "application/json",
                  "explode": false,
                  "allowReserved": false
                },
                "metrics": {
                  "contentType": "application/json",
                  "explode": false,
                  "allowReserved": false
                },
                "reconstruction_ids": {
                  "contentType": "application/json",
                  "explode": false,
                  "allowReserved": false
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Document created, URL follows",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Localization"
                  },
                  "type": "array"
                }
              }
            }
          },
          "400": {
            "description": "Bad request syntax or unsupported method",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status_code": {
                      "type": "integer"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "extra": {
                      "additionalProperties": {},
                      "anyOf": [
                        {
                          "type": "object"
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ],
                      "nullable": true
                    }
                  },
                  "type": "object",
                  "required": [
                    "detail",
                    "status_code"
                  ],
                  "description": "Validation Exception",
                  "example": {
                    "status_code": 400,
                    "detail": "Bad Request",
                    "extra": {}
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    },
    "/version": {
      "get": {
        "summary": "GetLocalizerVersion",
        "operationId": "get_localizer_version",
        "responses": {
          "200": {
            "description": "Request fulfilled, document follows",
            "headers": {},
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "components": {
    "schemas": {
      "AxisConvention": {
        "type": "string",
        "enum": [
          "OPENCV",
          "UNITY"
        ],
        "title": "AxisConvention"
      },
      "Float3": {
        "properties": {
          "x": {
            "type": "number",
            "format": "double"
          },
          "y": {
            "type": "number",
            "format": "double"
          },
          "z": {
            "type": "number",
            "format": "double"
          }
        },
        "type": "object",
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "Float3"
      },
      "Float4": {
        "properties": {
          "x": {
            "type": "number",
            "format": "double"
          },
          "y": {
            "type": "number",
            "format": "double"
          },
          "z": {
            "type": "number",
            "format": "double"
          },
          "w": {
            "type": "number",
            "format": "double"
          }
        },
        "type": "object",
        "required": [
          "w",
          "x",
          "y",
          "z"
        ],
        "title": "Float4"
      },
      "Localization": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "transform": {
            "$ref": "#/components/schemas/Transform"
          },
          "metrics": {
            "$ref": "#/components/schemas/LocalizationMetrics"
          }
        },
        "type": "object",
        "required": [
          "id",
          "metrics",
          "transform"
        ],
        "title": "Localization"
      },
      "LocalizationMetrics": {
        "properties": {
          "inlier_ratio": {
            "type": "number",
            "format": "double"
          },
          "reprojection_error_median": {
            "type": "number",
            "format": "double"
          },
          "num_inliers": {
            "type": "integer"
          },
          "num_correspondences": {
            "type": "integer"
          },
          "num_matches": {
            "type": "integer"
          },
          "inlier_coverage": {
            "type": "number",
            "format": "double"
          },
          "confidence_tight": {
            "type": "number",
            "format": "double"
          },
          "confidence_loose": {
            "type": "number",
            "format": "double"
          },
          "confidence_is_calibrated": {
            "type": "boolean"
          },
          "measurement_covariance": {
            "items": {
              "items": {
                "type": "number",
                "format": "double"
              },
              "type": "array"
            },
            "type": "array"
          },
          "pnp_covariance": {
            "items": {
              "items": {
                "type": "number",
                "format": "double"
              },
              "type": "array"
            },
            "type": "array"
          },
          "pipeline_version": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "confidence_is_calibrated",
          "confidence_loose",
          "confidence_tight",
          "inlier_coverage",
          "inlier_ratio",
          "measurement_covariance",
          "num_correspondences",
          "num_inliers",
          "num_matches",
          "pipeline_version",
          "pnp_covariance",
          "reprojection_error_median"
        ],
        "title": "LocalizationMetrics"
      },
      "LocalizationRequest": {
        "properties": {
          "reconstruction_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array"
          },
          "metrics": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ReconstructionMetrics"
            },
            "type": "object"
          },
          "camera_config": {
            "$ref": "#/components/schemas/PinholeCameraConfig"
          },
          "axis_convention": {
            "$ref": "#/components/schemas/AxisConvention"
          },
          "retrieval_top_k": {
            "nullable": true,
            "type": "integer"
          },
          "ransac_threshold": {
            "nullable": true,
            "type": "number",
            "format": "double"
          },
          "image": {
            "type": "string",
            "format": "binary"
          }
        },
        "type": "object",
        "required": [
          "axis_convention",
          "camera_config",
          "image",
          "metrics",
          "reconstruction_ids"
        ],
        "title": "LocalizationRequest"
      },
      "PhaseTiming": {
        "properties": {
          "phase": {
            "type": "string",
            "description": "ReconstructionStatus value of the phase, e.g. 'extracting_features'."
          },
          "duration_seconds": {
            "type": "number",
            "format": "double",
            "description": "Wall-clock seconds the phase spent in-flight."
          }
        },
        "type": "object",
        "required": [
          "duration_seconds",
          "phase"
        ],
        "title": "PhaseTiming"
      },
      "PinholeCameraConfig": {
        "properties": {
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "orientation": {
            "type": "string",
            "enum": [
              "TOP_LEFT",
              "TOP_RIGHT",
              "BOTTOM_RIGHT",
              "BOTTOM_LEFT",
              "LEFT_TOP",
              "RIGHT_TOP",
              "RIGHT_BOTTOM",
              "LEFT_BOTTOM"
            ]
          },
          "fx": {
            "type": "number",
            "format": "double"
          },
          "fy": {
            "type": "number",
            "format": "double"
          },
          "cx": {
            "type": "number",
            "format": "double"
          },
          "cy": {
            "type": "number",
            "format": "double"
          }
        },
        "type": "object",
        "required": [
          "cx",
          "cy",
          "fx",
          "fy",
          "height",
          "orientation",
          "width"
        ],
        "title": "PinholeCameraConfig"
      },
      "ReconstructionMetrics": {
        "properties": {
          "reprojection_pixel_error_50th_percentile": {
            "description": "Median reprojection error in pixels across all valid 2D observations in registered images.",
            "nullable": true,
            "type": "number",
            "format": "double"
          },
          "reprojection_pixel_error_90th_percentile": {
            "description": "90th percentile reprojection error in pixels across all valid 2D observations.",
            "nullable": true,
            "type": "number",
            "format": "double"
          },
          "track_length_50th_percentile": {
            "description": "Median number of distinct images observing each 3D point.",
            "nullable": true,
            "type": "number",
            "format": "double"
          },
          "all_verified_matches": {
            "description": "Total number of verified matches across all image pairs.",
            "nullable": true,
            "type": "integer"
          },
          "all_verified_match_rate": {
            "description": "Percentage of image pairs that passed two-view geometry verification.",
            "nullable": true,
            "type": "number",
            "format": "double"
          },
          "all_verified_match_inliers_mean": {
            "description": "Mean inlier count among verified image pairs.",
            "nullable": true,
            "type": "number",
            "format": "double"
          },
          "all_verified_match_inliers_median": {
            "description": "Median inlier count among verified image pairs.",
            "nullable": true,
            "type": "number",
            "format": "double"
          },
          "stereo_verified_matches": {
            "description": "Number of verified stereo pairs (same frame, different sensors).",
            "nullable": true,
            "type": "integer"
          },
          "stereo_verified_match_rate": {
            "description": "Percentage of stereo pairs that passed verification.",
            "nullable": true,
            "type": "number",
            "format": "double"
          },
          "stereo_verified_match_inliers_mean": {
            "description": "Mean inlier count among verified stereo pairs.",
            "nullable": true,
            "type": "number",
            "format": "double"
          },
          "stereo_verified_match_inliers_median": {
            "description": "Median inlier count among verified stereo pairs.",
            "nullable": true,
            "type": "number",
            "format": "double"
          },
          "map_image_count": {
            "description": "Number of registered images in the reconstruction.",
            "nullable": true,
            "type": "integer"
          },
          "map_point_count": {
            "description": "Number of triangulated 3D points in the reconstruction.",
            "nullable": true,
            "type": "integer"
          },
          "map_avg_track_length": {
            "description": "Mean number of image observations per 3D point.",
            "nullable": true,
            "type": "number",
            "format": "double"
          },
          "map_viewpoint_diversity": {
            "description": "1 minus the magnitude of the mean unit viewing direction across registered cameras; 0 means uniform direction, approaches 1 as viewpoints spread.",
            "nullable": true,
            "type": "number",
            "format": "double"
          },
          "gravity_aligned_in_map_frame": {
            "description": "True when per-frame gravity samples aligned the map's vertical axis; False when no samples were available and only origin-shift was applied.",
            "nullable": true,
            "type": "boolean"
          },
          "gravity_sample_count": {
            "description": "Number of registered frames that contributed gravity samples to the map-frame alignment.",
            "nullable": true,
            "type": "integer"
          },
          "prior_drift_residual_rms_m": {
            "description": "RMS residual in meters of a rigid Umeyama fit from map camera centers to VIO position priors; None when the capture has no priors or runs with use_prior_position off.",
            "nullable": true,
            "type": "number",
            "format": "double"
          },
          "prior_drift_residual_max_m": {
            "description": "Maximum residual in meters of the same Umeyama fit; surfaces single-frame outliers the RMS smooths over.",
            "nullable": true,
            "type": "number",
            "format": "double"
          },
          "phase_timings": {
            "description": "Per-phase wall-clock durations in execution order, captured at each set_phase boundary.",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/PhaseTiming"
            },
            "type": "array"
          },
          "pipeline_version": {
            "description": "RECONSTRUCTOR_SHA of the image that produced this reconstruction.",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object",
        "required": [],
        "title": "ReconstructionMetrics"
      },
      "Transform": {
        "properties": {
          "translation": {
            "$ref": "#/components/schemas/Float3"
          },
          "rotation": {
            "$ref": "#/components/schemas/Float4"
          }
        },
        "type": "object",
        "required": [
          "rotation",
          "translation"
        ],
        "title": "Transform"
      }
    }
  }
}