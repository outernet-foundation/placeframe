# Machine values — copy to boatyard.values.yaml (gitignored) and fill in.
# The ambient shell fills nothing; this file is the only machine-values source.

# The public face: the host the world dials (the ngrok domain here) plus its
# scheme. The four keys mint the PUBLIC_* slots the workloads and values
# reference (${PUBLIC_URL} is the composed scheme://host[:port] URL;
# ${EDGE_BASE_URL} the container-side gateway address).
public_host: <your-ngrok-domain>
public_scheme: https

# Assembly selection: bundles: names options by qualified group-option spelling
# — the accelerator (core-cuda or core-rocm), the auth edge (auth-keycloak;
# omitting it is the anonymous edge), and the relay (tunnel-ngrok).
# Known-good sets: [core-cuda, auth-keycloak, tunnel-ngrok] (OIDC with relay),
# [core-cuda, tunnel-ngrok] (anonymous with relay), [core-cuda] (anonymous,
# LAN/air-gap). AMD hosts: swap core-cuda for core-rocm.
bundles: [core-cuda]

# The gateway's published host port, overriding the config's gateway_port
# default (8443); this value governs prod.
gateway_port: 8443

# Machine values: one flat ALL_CAPS list under values; a key no assembly
# surface consumes refuses. Postgres/S3 dev defaults ride inside the bundles as
# :- fallbacks — set them only to override. Set all four AUTH_* endpoints for
# OIDC; drop them (or leave empty) for anonymous.
values:
  DEPLOYMENT_ENVIRONMENT: development
  AUTH_ISSUER_URL: ${PUBLIC_URL}/auth/realms/placeframe-dev
  AUTH_JWKS_URL: ${EDGE_BASE_URL}/auth/realms/placeframe-dev/protocol/openid-connect/certs
  AUTH_AUTHORIZATION_ENDPOINT: ${PUBLIC_URL}/auth/realms/placeframe-dev/protocol/openid-connect/auth
  AUTH_TOKEN_ENDPOINT: ${PUBLIC_URL}/auth/realms/placeframe-dev/protocol/openid-connect/token
  AUTH_AUDIENCE: placeframe-api
  KEYCLOAK_ADMIN_PASSWORD: password
  KEYCLOAK_ACCESS_TOKEN_LIFESPAN: 3600
  KEYCLOAK_SSO_SESSION_IDLE_TIMEOUT: 2592000
  KEYCLOAK_SSO_SESSION_MAX_LIFESPAN: 2592000
  # Optional test users, comma-separated username:password pairs; drop to seed none.
  SEED_TEST_USERS: user:password
  NGROK_DOMAIN: <your-ngrok-domain>
  NGROK_AUTHTOKEN: <your_ngrok_authtoken_here>
