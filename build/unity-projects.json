{
  "projects": {
    "LegacyOuternetClient": {
      "path": "legacy/Outernet.Client",
      "package": "com.Ogment.OuternetNYC.Beta",
      "builds": ["android-mobile", "magicleap"],
      "execute_methods": {
        "android-mobile": "Outernet.Client.Build.BuildForAndroidMobile",
        "magicleap": "Outernet.Client.Build.BuildForMagicLeap"
      }
    },
    "LegacyOuternetEditor": {
      "path": "legacy/Outernet.Client",
      "package": "com.Ogment.OuternetNYC.Beta",
      "builds": ["linux64", "win64"],
      "execute_methods": {
        "linux64": "Outernet.Client.Build.BuildForLinux64",
        "win64": "Outernet.Client.Build.BuildForWin64"
      }
    },
    "MapRegistrationTool": {
      "path": "apps/MapRegistrationTool",
      "builds": ["linux64", "win64"],
      "execute_methods": {
        "linux64": "Placeframe.MapRegistrationTool.Build.BuildForLinux64",
        "win64": "Placeframe.MapRegistrationTool.Build.BuildForWin64"
      }
    },
    "CaptureTool": {
      "path": "apps/AndroidMobile",
      "package": "com.outernet.captureapp",
      "builds": ["android-mobile"],
      "execute_methods": {
        "android-mobile": "Placeframe.Client.Build.BuildForAndroidMobile"
      },
      "grant_permissions": ["android.permission.READ_LOGS"]
    },
    "Placeframe": {
      "path": "packages/unity/Placeframe"
    }
  }
}
