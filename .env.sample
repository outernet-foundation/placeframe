PUBLIC_DOMAIN=<your_public_domain_here>
LOCALTONET_AUTHTOKEN=<your_localtonet_authtoken_here>

COMPOSE_PROFILES=localtonet

# How the gateway (Caddy) handles TLS for the public-facing HTTP surface:
#   plain    — Caddy serves cleartext HTTP; TLS is terminated by the upstream
#              tunnel relay (Localtonet's HTTP tunnel auto-provisions Let's
#              Encrypt). Use this when COMPOSE_PROFILES contains localtonet.
#   internal — Caddy terminates HTTPS itself using an internal CA. Use this
#              for LAN / air-gapped deployments. Clients see a self-signed
#              cert and must trust Caddy's CA out of band.
GATEWAY_TLS_MODE=plain

GATEWAY_PORT=58080
MINIO_CONSOLE_PORT=59001
CLOUDBEAVER_PORT=58978
GRAFANA_PORT=53000

KEYCLOAK_ACCESS_TOKEN_LIFESPAN=3600
KEYCLOAK_SSO_SESSION_IDLE_TIMEOUT=2592000
KEYCLOAK_SSO_SESSION_MAX_LIFESPAN=2592000
AUTH_AUDIENCE=placeframe-api
AUTH_WORKER_CLIENT_ID=placeframe-worker
AUTH_STATE_SYNC_CLIENT_ID=placeframe-state-sync

MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
POSTGRES_HOST=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=password
DATABASE_NAME=placeframe
DATABASE_OWNER_PASSWORD=password
DATABASE_API_USER_PASSWORD=password
DATABASE_AUTH_USER_PASSWORD=password
DATABASE_ORCHESTRATION_USER_PASSWORD=password
CLOUDBEAVER_ADMIN_USER=cbadmin
CLOUDBEAVER_ADMIN_PASSWORD=password

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretlongenoughforhs256signing
# Hostname that clients use to reach LiveKit's signaling channel (the
# WebSocket connection used to set up sessions and exchange ICE candidates).
# For a Localtonet setup, this is the subdomain of the TCP tunnel forwarding
# to localhost:7880. For LAN, the host's LAN hostname. For loopback-only dev,
# "localhost".
LIVEKIT_SIGNALING_DOMAIN=localhost
LIVEKIT_SIGNALING_PORT=7880
# Hostname/IP that LiveKit advertises in ICE candidates (where clients send
# their UDP media). For a Localtonet setup, the subdomain of the UDP tunnel
# forwarding to localhost:7882. For LAN, the host's LAN IP. For loopback-only
# dev, "127.0.0.1". LIVEKIT_RTC_PORT must equal the public port the tunnel
# exposes — LiveKit's bind port is its advertised port (no separate config
# for port translation), so the public port must match LiveKit's bind port
# (default 7882).
LIVEKIT_RTC_DOMAIN=127.0.0.1
LIVEKIT_RTC_PORT=7882

DEBUG_API=true
DEBUG_WAIT_API=false
DEBUG_RECONSTRUCTION_ORCHESTRATOR=true
DEBUG_WAIT_RECONSTRUCTION_ORCHESTRATOR=false
DEBUG_RUN_RECONSTRUCTION=true
DEBUG_WAIT_RUN_RECONSTRUCTION=true
DEBUG_FEATURES=true
DEBUG_WAIT_FEATURES=true
