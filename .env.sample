PUBLIC_URL=https://<your-ngrok-domain>
NGROK_DOMAIN=<your-ngrok-domain>
NGROK_AUTHTOKEN=<your_ngrok_authtoken_here>

# Assembly selection is structural — which compose artifacts `uv run up` layers:
# AUTH_ISSUER_URL presence selects the keycloak gateway (unset = anonymous gateway),
# NGROK_AUTHTOKEN presence brings the ngrok relay, TUNNEL_TOKEN presence brings the
# rathole relay (only when the ngrok block is commented out).

# Auth: issuer presence selects the mode (set = keycloak, unset = anonymous). The three
# endpoint URLs are required when the issuer is set; AUTH_AUDIENCE defaults to placeframe-api.
# Values are derived from PUBLIC_URL — substitute <your-ngrok-domain>. The realm path
# segment placeframe-dev is fixed (the name baked into the stack's keycloak realm).
# Comment all four out for anonymous mode.
AUTH_ISSUER_URL=https://<your-ngrok-domain>/auth/realms/placeframe-dev
AUTH_JWKS_URL=http://keycloak:8080/realms/placeframe-dev/protocol/openid-connect/certs
AUTH_AUTHORIZATION_ENDPOINT=https://<your-ngrok-domain>/auth/realms/placeframe-dev/protocol/openid-connect/auth
AUTH_TOKEN_ENDPOINT=https://<your-ngrok-domain>/auth/realms/placeframe-dev/protocol/openid-connect/token

# Rathole relay alternative (comment the ngrok block out first):
# TUNNEL_CONTROL_ENDPOINT=<rathole_server_endpoint>
# TUNNEL_TOKEN=<rathole_token>
# ENGINEER_NAME=<your_name>

DEPLOYMENT_ENVIRONMENT=development

GATEWAY_PORT=58080
SEAWEEDFS_ADMIN_PORT=59001
GRAFANA_PORT=53000

KEYCLOAK_ADMIN_PASSWORD=password
KEYCLOAK_ACCESS_TOKEN_LIFESPAN=3600
KEYCLOAK_SSO_SESSION_IDLE_TIMEOUT=2592000
KEYCLOAK_SSO_SESSION_MAX_LIFESPAN=2592000

# Optional test users the keycloak configurator seeds after the realm sync, as
# comma-separated username:password pairs (first/last name and email auto-populated —
# a fresh realm's profile requires all three or the first direct grant fails).
# Leave unset for no users.
# SEED_TEST_USERS=user:password,user2:password

S3_ACCESS_KEY=admin
S3_SECRET_KEY=password
POSTGRES_HOST=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=password
DATABASE_NAME=placeframe
DATABASE_OWNER_PASSWORD=password
DATABASE_API_USER_PASSWORD=password
DATABASE_AUTH_USER_PASSWORD=password
DATABASE_ORCHESTRATION_USER_PASSWORD=password
