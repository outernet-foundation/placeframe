# Tunnel choice: tunnel-ngrok or tunnel-rathole. Leave COMPOSE_PROFILES empty
# for air-gapped LAN operation (set PUBLIC_URL to this host's reachable LAN IP).
# AUTH_MODE=keycloak auto-activates the `keycloak` profile via `uv run up`, so
# only the tunnel profile needs to be listed here.
COMPOSE_PROFILES=tunnel-ngrok

# ngrok tunnel (used when COMPOSE_PROFILES=tunnel-ngrok)
PUBLIC_URL=https://<your-ngrok-domain>.ngrok-free.app
NGROK_DOMAIN=<your-ngrok-domain>.ngrok-free.app
NGROK_AUTHTOKEN=<your_ngrok_authtoken_here>

# Where local tools reach the API, when that differs from how the world reaches it.
# PUBLIC_URL is the stack's public identity: it configures the gateway, the OpenAPI server list and
# the issuer URLs, and it is what phones and the ZED box connect to -- so it has to stay routable
# from off the machine. But when it points at a tunnel, a CLI or dashboard running on the same host
# as the stack sends every byte out to the relay and back to a container beside it. Uncomment this
# to take the short way round; it changes nothing about what the stack tells the world it is.
#
# Only set this when the stack really is reachable at that address. It wins over PUBLIC_URL, so a
# stale value points local tools at the wrong stack -- which, if another stack answers there, is a
# quiet wrong answer rather than a connection error.
# PLACEFRAME_API_URL=http://localhost:58080

# rathole tunnel (used when COMPOSE_PROFILES=tunnel-rathole)
# Copy ENGINEER_NAME / TUNNEL_CONTROL_ENDPOINT / TUNNEL_TOKEN and the floating
# IP for PUBLIC_URL from `pulumi stack output engineers --show-secrets`.
# Comment out the ngrok PUBLIC_URL above and uncomment the line below.
# PUBLIC_URL=http://<your-floating-ip>:58080
# ENGINEER_NAME=<your-name>
# TUNNEL_CONTROL_ENDPOINT=<relay-ip>:2333
# TUNNEL_TOKEN=<your-rathole-token>

AUTH_MODE=keycloak
DEPLOYMENT_ENVIRONMENT=development

GATEWAY_PORT=58080
MINIO_CONSOLE_PORT=59001
CLOUDBEAVER_PORT=58978
GRAFANA_PORT=53000

KEYCLOAK_ACCESS_TOKEN_LIFESPAN=3600
KEYCLOAK_SSO_SESSION_IDLE_TIMEOUT=2592000
KEYCLOAK_SSO_SESSION_MAX_LIFESPAN=2592000
AUTH_AUDIENCE=placeframe-api
AUTH_WORKER_CLIENT_ID=placeframe-worker

MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
POSTGRES_HOST=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=password
DATABASE_NAME=placeframe
DATABASE_OWNER_PASSWORD=password
DATABASE_API_USER_PASSWORD=password
DATABASE_AUTH_USER_PASSWORD=password
DATABASE_ORCHESTRATION_USER_PASSWORD=password
CLOUDBEAVER_ADMIN_USER=cbadmin
CLOUDBEAVER_ADMIN_PASSWORD=password

DEBUG_API=true
DEBUG_WAIT_API=false
DEBUG_LEASE_SERVER=false
DEBUG_WAIT_LEASE_SERVER=false
