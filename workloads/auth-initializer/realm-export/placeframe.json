{
  "realm": "placeframe-dev",
  "enabled": true,
  "accessTokenLifespan": "${KEYCLOAK_ACCESS_TOKEN_LIFESPAN}",
  "accessTokenLifespanForImplicitFlow": "${KEYCLOAK_ACCESS_TOKEN_LIFESPAN}",
  "ssoSessionIdleTimeout": "${KEYCLOAK_SSO_SESSION_IDLE_TIMEOUT}",
  "ssoSessionMaxLifespan": "${KEYCLOAK_SSO_SESSION_MAX_LIFESPAN}",
  "clients": [
    {
      "clientId": "placeframe-api",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["${PUBLIC_URL}/schema", "${PUBLIC_URL}/schema/"],
      "webOrigins": ["${PUBLIC_URL}"],
      "protocolMappers": [
        {
          "name": "aud-placeframe-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "placeframe-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "placeframe-grafana",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["${PUBLIC_URL}/grafana/login/generic_oauth"],
      "webOrigins": ["${PUBLIC_URL}"]
    }
  ]
}
