          "datasource": { "type": "prometheus", "uid": "placeframe-prometheus" },
          "expr": "kube_pod_status_ready{namespace=\"outernet\", pod=~\"placeframe-localizer-.*\", condition=\"true\"}",
          "legendFormat": "Localizer"
