        pass

    @property
    def enable_2d_ground_mode(self) -> bool:
        """
         Whether to enable 2D localization mode
        """
        return bool()

    @enable_2d_ground_mode.setter
    def enable_2d_ground_mode(self, enable_2d_ground_mode: Any) -> None:
        pass

    @property
    def set_gravity_as_origin(self) -> bool:
